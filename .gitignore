# dependencies
node_modules/
.pnpm-store/

# build output
# NOTE: lib/ is intentionally COMMITTED — the package is distributed by
# git-install, so the prebuilt output must be in the tree (no build on the
# consumer). Rebuild with `npm run build` and commit before tagging a release.
*.tsbuildinfo

# env / secrets
.env
.env.local

# test / coverage
coverage/
.vitest-cache/

# logs
*.log
npm-debug.log*

# editor / os
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
